; apple-t2-composite.inf
; Owns only USB\VID_05AC&PID_8233 and forces usbccgp.sys as the parent driver.
; Does NOT install UsbNcm.sys or create a Net-class device.

[Version]
Signature   = "$WINDOWS NT$"
Class       = USB
ClassGuid   = {36fc9e60-c465-11cf-8056-444553540000}
Provider    = %ProviderName%
DriverVer   = 09/01/2026,2.0.0.0
CatalogFile = apple-t2-composite.cat
PnpLockdown = 1

[Manufacturer]
%ProviderName% = DeviceList, NTamd64

[DeviceList.NTamd64]
%AppleT2Composite.DeviceDesc% = AppleT2Composite_Install, USB\VID_05AC&PID_8233

[AppleT2Composite_Install]
Include = usb.inf
Needs   = Composite.Dev.NT

[Strings]
ProviderName                 = "Osaul4ik"
AppleT2Composite.DeviceDesc  = "Apple T2 USB Composite Device"