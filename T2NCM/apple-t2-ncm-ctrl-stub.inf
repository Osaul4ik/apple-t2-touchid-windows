; ============================================================================
; apple-t2-ncm-ctrl-stub.inf  ("Variant 1" stub half)
;
; Minimal stub binding for MI_00 (Apple T2 NCM Control interface).
;
; CHANGED: this now ships its OWN binary, T2NcmCtrl.sys (built from
; driver/CtrlStub.c by driver/T2NcmCtrl.vcxproj), instead of a second
; service name over the same T2Ncm.sys image. T2Ncm.sys became an NDIS
; miniport whose DriverEntry hands the driver object to NDIS and must not
; own its dispatch table; this stub is a classic KMDF function driver and
; must. One image cannot do both, and picking by RegistryPath inside a
; single shared image was never a sound arrangement to begin with.
;
; Why this exists: real hardware showed MI_00 and MI_01 enumerate as two
; INDEPENDENT PDOs under usbccgp (no IAD grouping them), so the driver
; bound to MI_01 cannot reach MI_00's interface object at all. Without
; SOME driver claiming MI_00, Device Manager shows it as an unclaimed
; device (Code 28/31, yellow bang) and — more importantly — an
; un-power-managed PDO can interfere with system sleep. This stub does
; nothing but claim the PDO and handle PnP/power cleanly (D0Entry/D0Exit
; both return STATUS_SUCCESS immediately, no blocking, no I/O), so
; Windows treats MI_00 as a normal, working, sleep-friendly device.
;
; Note that this driver IS a normal power policy owner for MI_00, unlike
; T2Ncm.sys where NDIS owns the power policy. That asymmetry is correct:
; MI_00 is a plain USB interface, not a network adapter.
;
; Deliberately Class=System, not Net — this is not a network adapter and
; must not register an NDIS miniport or appear as a NIC. (Class is a
; whole-INF directive, which is exactly why this is a separate file from
; apple-t2-ncm.inf rather than a second model section in it.)
;
; IMPORTANT:
;   - Matches ONLY:
;       USB\VID_05AC&PID_8233&REV_0201&MI_00
;       USB\VID_05AC&PID_8233&MI_00
;   - Does NOT match the composite parent (USB\VID_05AC&PID_8233).
;   - Does NOT match MI_01 (USB\VID_05AC&PID_8233&MI_01) — that's
;     apple-t2-ncm.inf's job.
;   - No NDI/AddReg section, no *IfType etc. — not a network device.
;
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 09/15/2026,2.1.0.0
CatalogFile = apple-t2-ncm-ctrl-stub.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir           = 12
T2NcmCtrlStub.CopyDriverFiles = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
T2NcmCtrl.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]

; Prefer the exact revision-specific hardware ID.
%AppleT2NcmCtrlStub.DeviceDesc% = AppleT2NcmCtrlStub_Install, USB\VID_05AC&PID_8233&REV_0201&MI_00

; Also support the same T2 NCM control interface without the revision
; component in the hardware ID.
%AppleT2NcmCtrlStub.DeviceDesc% = AppleT2NcmCtrlStub_Install, USB\VID_05AC&PID_8233&MI_00


; ============================================================================
; Stub device installation — no NDI section, this is not a NIC.
; ============================================================================

[AppleT2NcmCtrlStub_Install]
CopyFiles = T2NcmCtrlStub.CopyDriverFiles

[T2NcmCtrlStub.CopyDriverFiles]
T2NcmCtrl.sys


; ============================================================================
; T2NcmCtrlStub service — its own binary, unrelated to T2Ncm.sys.
; ============================================================================

[AppleT2NcmCtrlStub_Install.Services]
AddService = T2NcmCtrlStub, %SPSVCINST_ASSOCSERVICE%, T2NcmCtrlStub_Service_Inst

[T2NcmCtrlStub_Service_Inst]
DisplayName   = %T2NcmCtrlStub.SVCDESC%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\T2NcmCtrl.sys

[AppleT2NcmCtrlStub_Install.Wdf]
KmdfService = T2NcmCtrlStub, T2NcmCtrlStub_wdfsect

[T2NcmCtrlStub_wdfsect]
; Must track T2NcmCtrl.vcxproj's KMDF_VERSION_MAJOR/MINOR (currently
; 1.15, pinned for Windows 10 compatibility — see that file's comment).
KmdfLibraryVersion = 1.15


; ============================================================================
; Strings
; ============================================================================

[Strings]
ManufacturerName            = "Osaul4ik"
DiskName                    = "Apple T2 USB NCM Driver Package"

AppleT2NcmCtrlStub.DeviceDesc = "Apple T2 USB NCM Control Interface"

T2NcmCtrlStub.SVCDESC        = "Apple T2 NCM Control (stub)"
SPSVCINST_ASSOCSERVICE       = 0x00000002
