; ============================================================================
;  apple-t2-ncm.inf
;
; Apple T2 USB CDC-NCM function driver binding. Installs T2Ncm.sys — no
; UsbNcm.sys, usbncm.inf, or usb.inf involved.
;
; T2Ncm.sys is an NDIS 6.30 miniport driver. KMDF is still linked in and
; the .Wdf section below is still required, but the framework is used
; ONLY as a USB client library (DriverEntry creates it with
; WdfDriverInitNoDispatchOverride): NDIS — not KMDF — owns PnP and the
; power policy for this adapter. See driver/Driver.h.
;
; ARCHITECTURE CHANGE from the original design: real hardware showed
; MI_00 and MI_01 enumerate as TWO INDEPENDENT PDOs under usbccgp (no IAD
; grouping them), so a single WDFUSBDEVICE can never see both interfaces
; at once (WdfUsbTargetDeviceGetInterface(UsbDevice, 1) came back NULL
; from a device object created against MI_00's PDO). This driver now
; binds directly to MI_01 (NCM Data) instead of MI_00. Control-plane
; requests (GET_NTB_PARAMETERS etc., addressed by wIndex over the shared
; EP0) still work fine from here — they don't need MI_00's own interface
; object. MI_00 gets its own separate binding — and, as of this revision,
; its own separate binary (T2NcmCtrl.sys) — in
; apple-t2-ncm-ctrl-stub.inf, a minimal stub so MI_00 doesn't sit as an
; unclaimed Code-28/31 device. The two drivers no longer share an image:
; an NDIS miniport and a classic KMDF function driver need incompatible
; DriverEntry bodies.
;
; Parent:
;   USB\VID_05AC&PID_8233
;       |
;       +--> usbccgp.sys
;              |
;              +--> MI_00 = NCM Control  (apple-t2-ncm-ctrl-stub.inf,
;              |                          service "T2NcmCtrlStub")
;              |
;              +--> MI_01 = NCM Data     <-- THIS driver binds here
;                                            (service "T2Ncm")
;
; IMPORTANT:
;   - Matches ONLY:
;       USB\VID_05AC&PID_8233&REV_0201&MI_01
;       USB\VID_05AC&PID_8233&MI_01
;   - Does NOT match the composite parent (USB\VID_05AC&PID_8233).
;   - Does NOT match MI_00 (USB\VID_05AC&PID_8233&MI_00) — that's
;     apple-t2-ncm-ctrl-stub.inf's job.
;   - Does NOT Include=usbncm.inf or Needs=UsbNcm_Device.NT.
;
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 09/15/2026,2.1.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir      = 12
T2Ncm.CopyDriverFiles = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
T2Ncm.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]

; Prefer the exact revision-specific hardware ID.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&REV_0201&MI_01

; Also support the same T2 NCM data interface without the revision
; component in the hardware ID (Task 5: don't hard-code assumptions that
; only hold for one T2 revision).
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&MI_01


; ============================================================================
; NCM network adapter installation
; ============================================================================

[AppleT2Ncm_Install]
CopyFiles           = T2Ncm.CopyDriverFiles

Characteristics     = 0x84
BusType             = 15

*IfType             = 6
*MediaType          = 0
*PhysicalMediaType  = 0
*IfConnectorPresent = 1
*ConnectionType     = 1
*DirectionType      = 0
*AccessType         = 2
*HardwareLoopback   = 0

AddReg              = AppleT2Ncm_AddReg

[T2Ncm.CopyDriverFiles]
T2Ncm.sys


; ============================================================================
; T2Ncm.sys service — our own NDIS 6.30 miniport, NOT UsbNcm.
; ============================================================================

[AppleT2Ncm_Install.Services]
AddService = T2Ncm, %SPSVCINST_ASSOCSERVICE%, T2Ncm_Service_Inst

[T2Ncm_Service_Inst]
DisplayName   = %T2Ncm.SVCDESC%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\T2Ncm.sys

[AppleT2Ncm_Install.Wdf]
KmdfService = T2Ncm, T2Ncm_wdfsect

[T2Ncm_wdfsect]
; Must track T2Ncm.vcxproj's KMDF_VERSION_MAJOR/MINOR (currently 1.15,
; pinned for Windows 10 compatibility — see that file's comment).
KmdfLibraryVersion = 1.15


; ============================================================================
; NDI configuration
; ============================================================================

[AppleT2Ncm_AddReg]
HKR, Ndi,            Service,    0, "T2Ncm"

; UpperRange/LowerRange are what actually let the TCP/IP stack bind to
; this adapter — without them the miniport initializes and then sits
; there with nothing bound above it. "ethernet" has to agree with the
; NdisMedium802_3 / IF_TYPE_ETHERNET_CSMACD the miniport reports in its
; general attributes (NdisMiniport.c).
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

HKR, Ndi\params\NetworkAddress, Optional, 0, "1"


; ============================================================================
; Strings
; ============================================================================

[Strings]
ManufacturerName      = "Osaul4ik"
DiskName              = "Apple T2 USB NCM Driver Package"

AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"

T2Ncm.SVCDESC          = "Apple T2 NCM Transport"
SPSVCINST_ASSOCSERVICE = 0x00000002
