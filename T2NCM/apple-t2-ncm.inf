; apple-t2-ncm.inf
; Binds Microsoft Inbox UsbNcm.sys only to USB\VID_05AC&PID_8233&MI_00.
; Does NOT match MI_01 or the parent device.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 09/01/2026,2.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1

[Manufacturer]
%ProviderName% = DeviceList, NTamd64

[DeviceList.NTamd64]
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&MI_00

[AppleT2Ncm_Install]
Characteristics     = 0x84               ; NCF_PHYSICAL | NCF_NDIS_PROTOCOL
BusType             = 15                 ; PNPBus (USB)
*IfType             = 6                  ; IF_TYPE_ETHERNET_CSMACD
*MediaType          = 0                  ; NdisMedium802_3
*PhysicalMediaType  = 0                  ; NdisPhysicalMediumUnspecified
*IfConnectorPresent = 1                  ; TRUE
*ConnectionType     = 1                  ; NET_IF_CONNECTION_DEDICATED
*DirectionType      = 0                  ; NET_IF_DIRECTION_SENDRECEIVE
*AccessType         = 2                  ; NET_IF_ACCESS_BROADCAST
*HardwareLoopback   = 0                  ; FALSE

AddReg  = AppleT2Ncm_AddReg
Include = usbncm.inf
Needs   = UsbNcm_Device.NT

[AppleT2Ncm_Install.Services]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT.Services

[AppleT2Ncm_Install.HW]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT.HW

[AppleT2Ncm_AddReg]
; Minimal Net-class / NDIS registration required to avoid Code 56.
HKR, Ndi, Service,           0, "UsbNcm"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"
HKR,, EnumPropPages32,       0, "netcfgx.dll,NetPropPageProvider"

[Strings]
ProviderName        = "Osaul4ik"
AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"