; ============================================================================
; apple-t2-ncm.inf  (Task 3)
;
; Apple T2 USB CDC-NCM function driver binding — REPLACES the previous
; T2NCM/apple-t2-ncm.inf, which rebound MI_00 to the inbox UsbNcm.sys and
; produced Code 10 / STATUS_DEVICE_HARDWARE_ERROR (confirmed by USBPcap:
; no transactions after SET_CONFIGURATION before the failure). This INF
; installs the custom T2Ncm.sys instead and does not reference UsbNcm.sys,
; usbncm.inf, or usb.inf in any way.
;
; Parent:
;   USB\VID_05AC&PID_8233
;       |
;       +--> usbccgp.sys
;              |
;              +--> MI_00 = NCM Control  <-- THIS driver binds here
;              |
;              +--> MI_01 = NCM Data     (opened directly by T2Ncm.sys,
;                                          no separate driver — Task 3/
;                                          Critical constraints)
;
; IMPORTANT (Task 3 requirements):
;   - Matches ONLY:
;       USB\VID_05AC&PID_8233&REV_0201&MI_00
;       USB\VID_05AC&PID_8233&MI_00
;   - Does NOT match the composite parent (USB\VID_05AC&PID_8233).
;   - Does NOT match MI_01 (USB\VID_05AC&PID_8233&MI_01).
;   - Does NOT Include=usbncm.inf or Needs=UsbNcm_Device.NT.
;   - Ships and installs T2Ncm.sys as its own service — completely
;     replaces the Microsoft UsbNcm.sys binding for MI_00.
;
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 09/01/2026,2.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir      = 12
T2Ncm.CopyDriverFiles = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
T2Ncm.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]

; Prefer the exact revision-specific hardware ID.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&REV_0201&MI_00

; Also support the same T2 NCM control interface without the revision
; component in the hardware ID (Task 5: don't hard-code assumptions that
; only hold for one T2 revision).
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&MI_00


; ============================================================================
; NCM network adapter installation
; ============================================================================

[AppleT2Ncm_Install]
CopyFiles           = T2Ncm.CopyDriverFiles

Characteristics     = 0x84
BusType             = 15

*IfType             = 6
*MediaType          = 0
*PhysicalMediaType  = 0
*IfConnectorPresent = 1
*ConnectionType     = 1
*DirectionType      = 0
*AccessType         = 2
*HardwareLoopback   = 0

AddReg              = AppleT2Ncm_AddReg

[T2Ncm.CopyDriverFiles]
T2Ncm.sys


; ============================================================================
; T2Ncm.sys service — our own KMDF+NDIS driver, NOT UsbNcm.
; ============================================================================

[AppleT2Ncm_Install.Services]
AddService = T2Ncm, %SPSVCINST_ASSOCSERVICE%, T2Ncm_Service_Inst

[T2Ncm_Service_Inst]
DisplayName   = %T2Ncm.SVCDESC%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\T2Ncm.sys

[AppleT2Ncm_Install.Wdf]
KmdfService = T2Ncm, T2Ncm_wdfsect

[T2Ncm_wdfsect]
; Must track T2Ncm.vcxproj's KMDF_VERSION_MAJOR/MINOR (currently 1.15,
; pinned for Windows 10 compatibility — see that file's comment).
KmdfLibraryVersion = 1.15


; ============================================================================
; NDI configuration
; ============================================================================

[AppleT2Ncm_AddReg]
HKR, Ndi, Service, 0, "T2Ncm"
HKR, Ndi\params\NetworkAddress, Optional, 0, "1"


; ============================================================================
; Strings
; ============================================================================

[Strings]
ManufacturerName      = "Osaul4ik"
DiskName              = "Apple T2 USB NCM Driver Package"

AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"

T2Ncm.SVCDESC          = "Apple T2 NCM Transport"
SPSVCINST_ASSOCSERVICE = 0x00000002
