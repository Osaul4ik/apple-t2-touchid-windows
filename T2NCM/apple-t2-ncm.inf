; apple-t2-ncm.inf
;
; Apple T2 USB CDC-NCM (VID_05AC&PID_8233)
; Project-owned package that binds the Windows inbox UsbNcm.sys to the
; T2 NCM composite parent. No private copy of UsbNcm.sys is shipped.
;
; Why parent, not MI_00/MI_01:
;   When Apple oem15.inf Null is bound to the parent, child PDOs for
;   MI_00/MI_01 are never created. Matching only &MI_00 therefore can
;   never install. Hardware confirmation: installing the stock Microsoft
;   NCM driver on the parent causes MI_00/MI_01 to appear.
;
; Topology after this package wins the parent match (PnP rank over
; Apple null — we do NOT edit oem15.inf):
;
;   USB\VID_05AC&PID_8233
;           │
;           ▼
;      this INF → UsbNcm.sys (inbox)
;           │
;           ├── MI_00  CDC NCM Control   (appear once parent is NCM)
;           └── MI_01  CDC NCM Data
;                    │
;                    ▼
;              one NDIS network adapter
;
; No filter driver, no custom bus driver, no redistribution of UsbNcm.sys.
;
; SPDX-License-Identifier: GPL-2.0-only

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 08/30/2026,1.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1

[DestinationDirs]
; No files are copied; UsbNcm.sys lives in the Windows inbox Driver Store.

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
; Intentionally empty — inbox driver only.

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
; Parent composite device — same HWID Apple null uses.
; Winning this match (higher rank / our signed package) is what allows
; MI_00/MI_01 to enumerate; we do not modify oem15.inf.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233

; ---------------------------------------------------------------------------
; Pull DDInstall / Services / HW from the Microsoft inbox usbncm.inf.
; Section names match the public form of that INF on Windows 10 1709+ /
; Windows 11 (UsbNcm_Device.NT / .Services / .HW).
; ---------------------------------------------------------------------------

[AppleT2Ncm_Install]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT

[AppleT2Ncm_Install.Services]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT.Services

[AppleT2Ncm_Install.HW]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT.HW

[Strings]
ManufacturerName      = "Apple T2 Touch ID (community)"
DiskName              = "Apple T2 USB NCM Driver Package"
AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"
