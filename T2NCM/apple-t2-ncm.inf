; apple-t2-ncm.inf
;
; Apple T2 USB CDC-NCM (VID_05AC&PID_8233) — parent composite.
; Binds inbox UsbNcm.sys. Does not ship UsbNcm.sys. Does not edit oem15.inf.
;
; Hardware note: Apple null on the parent hides MI_00/MI_01. Installing NCM
; on the parent is what makes those interfaces appear. Code 56
; (CM_PROB_NEED_CLASS_CONFIG) was observed when only Include/Needs was used;
; this revision adds explicit Ndi/Characteristics AddReg mirroring the
; public usbncm.inf layout so the Net class installer can finish.
;
; SPDX-License-Identifier: GPL-2.0-only

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 08/30/2026,1.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233

; ---------------------------------------------------------------------------
; DDInstall: pull Microsoft service definition + explicit Ndi keys.
; ---------------------------------------------------------------------------

[AppleT2Ncm_Install]
Characteristics = 0x84
BusType         = 15
*IfType             = 6
*MediaType          = 0
*PhysicalMediaType  = 0
*IfConnectorPresent = 1
*ConnectionType     = 1
*DirectionType      = 0
*AccessType         = 2
*HardwareLoopback   = 0
AddReg          = AppleT2Ncm_AddReg
Include         = usbncm.inf
Needs           = UsbNcm_Device.NT

[AppleT2Ncm_Install.Services]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT.Services

[AppleT2Ncm_Install.HW]
Include = usbncm.inf
Needs   = UsbNcm_Device.NT.HW

; Explicit Ndi — same shape as inbox usbncm.inf UsbNcm_AddReg.
; Guarantees UpperRange/LowerRange even if Needs expansion is incomplete.
[AppleT2Ncm_AddReg]
HKR, Ndi,            Service,    0, "UsbNcm"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"
HKR,,                EnumPropPages32, 0, "netcfgx.dll,NetPropPageProvider"

[Strings]
ManufacturerName      = "Apple T2 Touch ID (community)"
DiskName              = "Apple T2 USB NCM Driver Package"
AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"
