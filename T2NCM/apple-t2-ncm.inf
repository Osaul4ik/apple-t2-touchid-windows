; ============================================================================
; apple-t2-ncm.inf
;
; Apple T2 USB CDC-NCM function binding
;
; Target:
;   USB\VID_05AC&PID_8233&REV_0201&MI_00
;   USB\VID_05AC&PID_8233&MI_00
;
; Parent:
;   USB\VID_05AC&PID_8233
;       |
;       +--> usbccgp.sys
;              |
;              +--> MI_00 = NCM Control
;              |
;              +--> MI_01 = NCM Data
;
; This INF binds ONLY the NCM control/function interface (MI_00).
;
; MI_01 is intentionally NOT matched by this INF. It is the CDC-NCM
; subordinate data interface and is handled as part of the same NCM
; function by UsbNcm.sys.
;
; The Microsoft inbox usbncm.inf normally has:
;
;   USB\MS_COMP_WINNCM
;
; and also contains the generic CDC-NCM match:
;
;   USB\Class_02&SubClass_0d&Prot_00
;
; but that generic match is commented out in the installed Microsoft
; usbncm.inf.
;
; Third-party USB function packages must not install through generic
; USB\Class_* compatible IDs. Therefore this package uses only the
; Apple T2 VID/PID hardware IDs.
;
; The Microsoft UsbNcm installation sections are reused through
; Include/Needs. This package does NOT ship or replace UsbNcm.sys.
;
; Does not:
;   - match the composite parent
;   - match MI_01
;   - modify usb.inf
;   - modify usbncm.inf
;   - modify Apple's oem*.inf
;   - ship UsbNcm.sys
;
; SPDX-License-Identifier: GPL-2.0-only
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 09/01/2026,2.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1


[DestinationDirs]
DefaultDestDir = 12


[SourceDisksNames]
1 = %DiskName%,,,""


[SourceDisksFiles]


[Manufacturer]
%ManufacturerName% = Standard,NTamd64


; ============================================================================
; Device models
;
; Only VID/PID hardware IDs are used.
;
; MI_00 is the CDC-NCM Communication/Class interface:
;
;   Class    = 02
;   SubClass = 0D
;   Protocol = 00
;
; Its Compatible IDs are:
;
;   USB\Class_02&SubClass_0d&Prot_00
;   USB\Class_02&SubClass_0d
;   USB\Class_02
;
; We deliberately DO NOT put those generic compatible IDs here because
; Inf2Cat/USB third-party signability rejects USB\Class_* matches.
; ============================================================================

[Standard.NTamd64]

%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&REV_0201&MI_00
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&MI_00


; ============================================================================
; DDInstall
;
; Reuse Microsoft's inbox UsbNcm installation definition.
;
; The referenced Microsoft section provides the actual NCM driver
; configuration used to install UsbNcm.sys.
; ============================================================================

[AppleT2Ncm_Install]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT


; ============================================================================
; Service installation
;
; Reuse the Microsoft inbox UsbNcm service definition.
; ============================================================================

[AppleT2Ncm_Install.Services]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT.Services


; ============================================================================
; Hardware-specific configuration
;
; Reuse the Microsoft inbox UsbNcm hardware configuration.
; ============================================================================

[AppleT2Ncm_Install.HW]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT.HW


; ============================================================================
; Strings
; ============================================================================

[Strings]

ManufacturerName      = "Osaul4ik"
DiskName              = "Apple T2 USB NCM Driver Package"
AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"