; ============================================================================
; apple-t2-ncm.inf
;
; Apple T2 CDC-NCM binding
;
; Parent:
;   USB\VID_05AC&PID_8233 -> usbccgp.sys
;
; NCM control interface:
;   USB\VID_05AC&PID_8233&MI_00
;   Compatible ID:
;   USB\Class_02&SubClass_0d&Prot_00
;
; Data interface:
;   USB\VID_05AC&PID_8233&MI_01
;   No separate driver.
;
; This version intentionally reuses Microsoft's inbox UsbNcm_Device
; configuration instead of duplicating its service/WDF configuration.
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 09/01/2026,2.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]

; T2-specific hardware match.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&REV_0201&MI_00
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&MI_00


; Also expose the same generic CDC-NCM match used by Microsoft's
; usbncm.inf. This corresponds exactly to the Compatible ID generated
; by usbccgp for T2 MI_00.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\Class_02&SubClass_0d&Prot_00


[AppleT2Ncm_Install]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT


[AppleT2Ncm_Install.Services]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT.Services


[AppleT2Ncm_Install.HW]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT.HW


[Strings]

ManufacturerName      = "Osaul4ik"
DiskName              = "Apple T2 USB NCM Driver Package"
AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"