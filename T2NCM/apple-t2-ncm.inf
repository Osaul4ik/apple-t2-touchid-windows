; ============================================================================
; apple-t2-ncm.inf
;
; Apple T2 USB CDC-NCM function driver binding
;
; Parent:
;   USB\VID_05AC&PID_8233
;       |
;       +--> usbccgp.sys
;              |
;              +--> MI_00 = NCM Control
;              |
;              +--> MI_01 = NCM Data
;
; This INF binds ONLY the NCM control interface MI_00.
;
; MI_01 is intentionally NOT matched by this package. It is the subordinate
; CDC-Data interface of the same CDC-NCM function.
;
; This package:
;   - matches only VID/PID hardware IDs
;   - reuses Microsoft usbncm.inf installation sections
;   - installs/uses the inbox UsbNcm service
;   - does not ship UsbNcm.sys
;   - does not modify usb.inf
;   - does not modify usbncm.inf
;   - does not modify Apple's oem*.inf
;   - does not match the composite parent
;   - does not match MI_01
;
; The installed Microsoft usbncm.inf uses USB\MS_COMP_WINNCM as its primary
; model match. Its generic USB\Class_02&SubClass_0d&Prot_00 model entry is
; commented out. We therefore provide a T2-specific VID/PID/MI_00 match here.
;
; SPDX-License-Identifier: GPL-2.0-only
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 09/01/2026,2.0.0.0
CatalogFile = apple-t2-ncm.cat
PnpLockdown = 1


[DestinationDirs]
DefaultDestDir = 12


[SourceDisksNames]
1 = %DiskName%,,,""


[SourceDisksFiles]


[Manufacturer]
%ManufacturerName% = Standard,NTamd64


; ============================================================================
; Device models
;
; IMPORTANT:
; Do NOT add:
;
;   USB\Class_02
;   USB\Class_02&SubClass_0d
;   USB\Class_02&SubClass_0d&Prot_00
;
; Third-party USB function packages must use VID/PID-based device IDs.
; ============================================================================

[Standard.NTamd64]

; Exact T2 revision-specific NCM control interface.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&REV_0201&MI_00

; T2 NCM control interface without revision component.
%AppleT2Ncm.DeviceDesc% = AppleT2Ncm_Install, USB\VID_05AC&PID_8233&MI_00


; ============================================================================
; DDInstall
;
; Reuse Microsoft's inbox UsbNcm installation definition.
; ============================================================================

[AppleT2Ncm_Install]

AddReg  = AppleT2Ncm_AddReg

Include = usbncm.inf
Needs   = UsbNcm_Device.NT


; ============================================================================
; Service installation
;
; Reuse Microsoft's inbox UsbNcm service installation.
; ============================================================================

[AppleT2Ncm_Install.Services]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT.Services


; ============================================================================
; Hardware configuration
;
; Reuse Microsoft's inbox UsbNcm hardware configuration.
; ============================================================================

[AppleT2Ncm_Install.HW]

Include = usbncm.inf
Needs   = UsbNcm_Device.NT.HW


; ============================================================================
; NDI configuration
;
; These entries provide the Net-class configuration required for the
; third-party package.
; ============================================================================

[AppleT2Ncm_AddReg]

; Associate the NDI device with Microsoft's inbox UsbNcm service.
HKR, Ndi, Service, 0, "UsbNcm"

; Network stack interface ranges.
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

; Standard network property-page provider.
HKR,, EnumPropPages32, 0, "netcfgx.dll,NetPropPageProvider"


; ============================================================================
; Strings
; ============================================================================

[Strings]

ManufacturerName      = "Osaul4ik"
DiskName              = "Apple T2 USB NCM Driver Package"
AppleT2Ncm.DeviceDesc = "Apple T2 USB NCM Network Adapter"