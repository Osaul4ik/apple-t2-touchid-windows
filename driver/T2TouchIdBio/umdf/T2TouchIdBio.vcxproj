<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone on purpose: NOT in T2TouchId.sln. Cit2touchid.yml and
     BuildT2TouchId.yml build the whole .sln, so adding a UMDF project there
     would put this (unbuilt) skeleton on the critical path of the working
     KMDF CI. Add it to the .sln once it builds. -->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{BC44B7B1-EE09-42C1-BE75-561E7BBE0000}</ProjectGuid>
    <RootNamespace>T2TouchIdBio</RootNamespace>
    <!-- Same reasoning as KMDF_VERSION_MINOR in T2TouchIdTransport.vcxproj:
         pin to the first UMDF 2 minor shipped in Windows 10 1507 so the
         driver loads on Windows 10, not only Windows 11. Must match the -u
         value passed to StampInf. -->
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <UMDF_VERSION_MINOR>15</UMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
    <!-- Desktop, not Universal: avoids ApiValidator failures on the WinBio
         headers while this is still a skeleton. -->
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <DriverType>UMDF</DriverType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <DriverType>UMDF</DriverType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <TargetName>T2TouchIdBio</TargetName>
    <OutDir>build\$(TargetName)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>build\$(TargetName)\$(Platform)\$(Configuration)\obj\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Same fallback pattern as protocol/T2TouchIdProtocol.vcxproj: local
         vcpkg checkout next to the .sln, overridable on the command line
         (BuildT2TouchId.yml passes the real values after `vcpkg install`).
         Needed here because BridgeXpc/Connection.cpp (linked in below via
         Discovery/BridgeDiscovery.cpp's dependency chain) pulls in
         BridgeXpc/PlistPayload.cpp, which needs libplist. -->
    <VcpkgInstalledDir Condition="'$(VcpkgInstalledDir)'==''">$(SolutionDir)vcpkg\installed\x64-windows</VcpkgInstalledDir>
    <PlistLibName Condition="'$(PlistLibName)'==''">plist-2.0.lib</PlistLibName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- protocol/ code uses try/catch + iostreams (C4530 under /WX otherwise). -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- ../../../protocol lets Internal.h/Queue.cpp #include protocol
           headers by the same relative path tools/t2touchid/main.cpp uses
           from its own directory depth. -->
      <AdditionalIncludeDirectories>..\..\..\protocol;$(VcpkgInstalledDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- OPEN RISK, not yet verified on hardware/a real build (see
           Internal.h's top comment and driver/T2TouchIdBio/docs/
           Windows-hello-design.MD section 2's own open-question list):
           protocol/T2TouchIdProtocol.vcxproj (these four .cpp below) is a
           PlatformToolset=v143 desktop StaticLibrary project; this project
           is PlatformToolset=WindowsUserModeDriver10.0 / DriverType=UMDF.
           Compiling the same protocol .cpp files directly into THIS project
           (rather than linking the other project's .lib output) sidesteps
           any CRT-linkage mismatch between the two toolsets (a UMDF driver
           commonly wants a static CRT; the desktop CLI/lib project may not)
           - but it has not been confirmed to actually link clean under the
           UMDF driver toolset's default runtime library setting. If this
           fails to link, the likely fix is an explicit matching
           <RuntimeLibrary> setting here and in
           protocol/T2TouchIdProtocol.vcxproj, not a change to the C++ code.
           ws2_32.lib is required directly (BridgeXpc/Discovery use raw
           Winsock, not a wrapper this project already links). -->
      <AdditionalDependencies>ws2_32.lib;$(VcpkgInstalledDir)\lib\$(PlistLibName);%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Driver.cpp" />
    <ClCompile Include="Queue.cpp" />
    <!-- Protocol sources this driver now depends on (CAPTURE_DATA ->
         VerificationEngine -> BridgeXpc -> Discovery). Compiled directly
         into this project rather than referenced as a .lib - see the
         Link/AdditionalDependencies comment above for why, and the open
         risk that goes with it. Keep this list in sync with
         protocol/T2TouchIdProtocol.vcxproj's own ClCompile ItemGroup minus
         AppleKeyStore/Client.cpp (CAPTURE_DATA never touches AppleKeyStore -
         that's the T2SepBootstrap service's job, design doc 9.2). -->
    <ClCompile Include="..\..\..\protocol\BiometricKit\Commands.cpp" />
    <ClCompile Include="..\..\..\protocol\BiometricKit\MatchResult.cpp" />
    <ClCompile Include="..\..\..\protocol\BiometricKit\VerificationEngine.cpp" />
    <ClCompile Include="..\..\..\protocol\BridgeXpc\Connection.cpp" />
    <ClCompile Include="..\..\..\protocol\BridgeXpc\Frame.cpp" />
    <ClCompile Include="..\..\..\protocol\BridgeXpc\PlistPayload.cpp" />
    <ClCompile Include="..\..\..\protocol\Discovery\Adapter.cpp" />
    <ClCompile Include="..\..\..\protocol\Discovery\BridgeDiscovery.cpp" />
    <ClCompile Include="..\..\..\protocol\Discovery\PortCache.cpp" />
    <ClCompile Include="..\..\..\protocol\Discovery\PortScan.cpp" />
    <ClCompile Include="..\..\..\protocol\Discovery\RemoteXpc.cpp" />
    <!-- Client.cpp: SEP readiness gate (Internal.h / Queue.cpp CheckSepReady),
         same "compile the protocol .cpp directly, no ProjectReference" shape
         as everything else in this list — see the block comment above them. -->
    <ClCompile Include="..\..\..\protocol\AppleKeyStore\Client.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Internal.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- No <Inf> item, same reason as T2TouchIdTransport.vcxproj (automatic
         InfVerif needs the x86 InfVerif.dll). Stamp / Inf2Cat / sign the
         .inf as separate steps - see README.md. -->
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>