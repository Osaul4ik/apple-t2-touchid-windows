; T2TouchIdBio.inf - WBDI biometric driver (UMDF 2), root-enumerated.
; PoC-only. Not WHQL signed. Test-signing required (same as T2TouchIdTransport).
;
; There is no bus-enumerated hardware behind this node: the SEP is already
; owned by T2TouchIdTransport.sys, so this is a virtual device (design doc
; 7.2). Create it once with:  devcon install T2TouchIdBio.inf root\T2TouchIdBio

[Version]
Signature   = "$WINDOWS NT$"
Class       = Biometric
ClassGuid   = {53D29EF7-377C-4D14-864B-EB3A85769359}
Provider    = %ManufacturerName%
DriverVer   = ; filled by build
CatalogFile = T2TouchIdBio.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
%T2TouchIdBio.DeviceDesc% = T2TouchIdBio_Install, root\T2TouchIdBio

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
T2TouchIdBio.dll = 1,,
T2TouchIdEngineAdapter.dll = 1,,

[DestinationDirs]
UMDriverCopy = 13
; Engine adapter is loaded by wbiosrvc by file name from System32\WinBioPlugIns
; (same layout as the Microsoft WBDI sample INF: DIRID 11 = System32).
WinBioEngineAdapterCopy = 11,WinBioPlugIns

[T2TouchIdBio_Install.NT]
CopyFiles = UMDriverCopy, WinBioEngineAdapterCopy

[T2TouchIdBio_Install.NT.HW]
AddReg = T2TouchIdBio_HwAddReg, T2TouchIdBio_PlugInAddReg, T2TouchIdBio_DatabaseAddReg

[T2TouchIdBio_HwAddReg]
; ACL and exclusivity from the "installing a biometric driver" docs, as
; recorded in design doc 7.2.
HKR,,DeviceCharacteristics,0x00010001,0x0100
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"
HKR,,Exclusive,0x00010001,1

; WBF biometric unit (Microsoft "Installing a Biometric Driver", steps 4-5).
; Without these two sections WBF has no unit configuration for the device and
; Settings -> Sign-in options reports "no compatible devices" even though the
; device node is healthy. Sensor + storage adapters are the in-box ones; the
; engine adapter is OURS (driver\T2TouchIdBio\EngineAdapter, design doc 7.4)
; and is copied to System32\WinBioPlugIns by [WinBioEngineAdapterCopy] below.
; Missing/unloadable engine DLL = the unit cannot be configured and WBF logs
; Event 1109 in Biometrics/Operational (0x80070002 when the file is absent).
; No SystemWakeEnabled/DeviceIdle* keys from the sample: they are for real USB
; sensors; this is a virtual root device.
[T2TouchIdBio_PlugInAddReg]
HKR,WinBio\Configurations,DefaultConfiguration,,"0"
HKR,WinBio\Configurations\0,SensorMode,0x00010001,1
HKR,WinBio\Configurations\0,SystemSensor,0x00010001,1
HKR,WinBio\Configurations\0,SensorAdapterBinary,,"WinBioSensorAdapter.dll"
HKR,WinBio\Configurations\0,EngineAdapterBinary,,"T2TouchIdEngineAdapter.dll"
HKR,WinBio\Configurations\0,StorageAdapterBinary,,"WinBioStorageAdapter.dll"
HKR,WinBio\Configurations\0,DatabaseId,,"%DatabaseId%"

[T2TouchIdBio_DatabaseAddReg]
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",BiometricType,0x00010001,0x00000008
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",Attributes,0x00010001,0x00000001
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",Format,,"00000000-0000-0000-0000-000000000000"
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",InitialSize,0x00010001,0x00000020
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",AutoCreate,0x00010001,0x00000001
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",AutoName,0x00010001,0x00000001
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",FilePath,,""
HKLM,"System\CurrentControlSet\Services\WbioSrvc\Databases\{%DatabaseId%}",ConnectionString,,""

[T2TouchIdBio_Install.NT.Services]
AddService = WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[T2TouchIdBio_Install.NT.Wdf]
UmdfService              = T2TouchIdBio, T2TouchIdBio_UmdfInstall
UmdfServiceOrder         = T2TouchIdBio
UmdfHostProcessSharing   = ProcessSharingDisabled

[T2TouchIdBio_UmdfInstall]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\T2TouchIdBio.dll

[UMDriverCopy]
T2TouchIdBio.dll

[WinBioEngineAdapterCopy]
T2TouchIdEngineAdapter.dll

[Strings]
; Unique per vendor database (docs: do not reuse the sample GUID).
DatabaseId                = "B039A555-3EEC-475A-ABBD-3AA5C5F550DA"
ManufacturerName          = "Osaul4ik"
DiskName                  = "T2TouchIdBio Installation Disk"
T2TouchIdBio.DeviceDesc   = "Apple T2 Touch ID (Windows Hello sensor)"
WudfRdDisplayName         = "Windows Driver Foundation - User-mode Driver Framework Reflector"
