<Window x:Class="T2TouchId.SepVaultGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T2 Touch ID"
        Width="580" Height="780"
        MinWidth="520" MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="#F4F5F7">

    <Window.Resources>

        <!-- ============================ Palette ============================ -->
        <SolidColorBrush x:Key="BrushAccent" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="BrushAccentPressed" Color="#1E40AF"/>
        <SolidColorBrush x:Key="BrushAccentSoft" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="BrushText" Color="#111827"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="BrushLine" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BrushInputLine" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="BrushDanger" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrushDangerSoft" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="BrushAmber" Color="#D97706"/>
        <SolidColorBrush x:Key="BrushAmberSoft" Color="#FEF3C7"/>

        <!-- ============================ Text styles ============================ -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatusLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============================ Card ============================ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================ Buttons ============================ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BrushInputLine}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Toggle switch (CheckBox) ============================ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    Background="#CBD0D8" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,1,0,0"
                                              VerticalAlignment="Top" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Inputs ============================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushInputLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushInputLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Padding="28,24,28,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="0.62"/>
                    <GradientStop Color="#4F8BFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="56" Height="56" CornerRadius="16" Background="#33FFFFFF" Margin="0,0,16,0">
                    <Viewbox Width="32" Height="32">
                        <Canvas Width="48" Height="48">
                            <Path Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M6,34 C6,16 14,6 24,6 C34,6 42,16 42,34"/>
                            <Path Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,37 C12,21 17,12 24,12 C31,12 36,21 36,33"/>
                            <Path Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M18,40 C18,27 20,18 24,18 C28,18 30,25 30,31"/>
                            <Path Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M24,26 L24,42"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="T2 Touch ID for Windows" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Secure Enclave status and setup" FontSize="13" Foreground="#CCFFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,12">

                <!-- ===================== SEP status card ===================== -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border x:Name="SepStatusHalo" CornerRadius="15" Background="#9CA3AF" Opacity="0.22"/>
                                <Border x:Name="SepStatusDot" Width="12" Height="12" CornerRadius="6" Background="#9CA3AF"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="SepStatusTitle" Style="{StaticResource CardTitle}"
                                           Text="SEP status unknown"/>
                                <TextBlock x:Name="SepStatusSubtitle" Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="No boot attempt has been reported in this session yet."/>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh"
                                    Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Center" Click="OnRefreshStatus"/>
                        </Grid>

                        <!-- Only shown when the diagnosed reason is "SEP wedged": the exact
                             fix the user needs, spelled out as steps, not buried in the log. -->
                        <Border Grid.Row="1" x:Name="SepHangPanel" Visibility="Collapsed"
                                Background="{StaticResource BrushDangerSoft}" CornerRadius="10"
                                Padding="16,14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="#B3261E" Margin="0,0,0,8"
                                           Text="SEP is not responding (hardware hang)"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#5A1611" Margin="0,0,0,4"
                                           Text="1. Restart the computer and boot into macOS."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#5A1611" Margin="0,0,0,4"
                                           Text="2. An error may appear early during the macOS boot. That is expected: it resets the SEP."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#5A1611" Margin="0,0,0,8"
                                           Text="3. Restart again and boot into Windows. Touch ID should work."/>
                                <TextBlock TextWrapping="Wrap" Foreground="#8A3B36" FontStyle="Italic" FontSize="11.5"
                                           Text="Retrying from Windows will not help. This is not a software error in the service."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===================== Network card ===================== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE774;"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource CardTitle}" Text="Network transport"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="How Windows talks to the T2 over USB."/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AutoSwitchCheck" Style="{StaticResource ToggleSwitch}"
                                  Checked="OnAutoSwitchChanged" Unchecked="OnAutoSwitchChanged">
                            <StackPanel>
                                <TextBlock Text="Automatic IPv6 → IPv4 fallback" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="Tries native IPv6 first. If a VPN or firewall blocks it, the connection switches to an IPv4 tunnel instantly, and returns to IPv6 when the network changes."/>
                            </StackPanel>
                        </CheckBox>

                        <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushLine}"
                                BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,16,0,0">
                            <TextBlock x:Name="TransportStatusText" Style="{StaticResource StatusLine}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===================== Verification card ===================== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73E;"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource CardTitle}" Text="Verification"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="Command sequence sent to the sensor before each match."/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ShortVerifyCheck" Style="{StaticResource ToggleSwitch}"
                                  Checked="OnShortVerifyChanged" Unchecked="OnShortVerifyChanged">
                            <StackPanel>
                                <TextBlock Text="Fast verification" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="Skips ResetSensor and LoadCalibration. Cancel, the identity list and the stability check still run. Off = the full Linux (t2-fprintd) sequence. Applies from the next verification."/>
                            </StackPanel>
                        </CheckBox>

                        <TextBlock x:Name="ShortVerifyStatusText" Style="{StaticResource StatusLine}" Margin="52,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================== Keybag import card ===================== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconBadge}">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72E;"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource CardTitle}" Text="One-time keybag import"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="user.kb is encrypted with DPAPI (machine scope) and stored in %ProgramData%\T2TouchId\sep-vault.bin. T2SepBootstrap reads it on every cold start."/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Keybag file"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="KeybagPathBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                                    Click="OnBrowseKeybag"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Special bag ID"/>
                                <TextBox x:Name="SpecialBagBox" Text="-501"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                                <PasswordBox x:Name="PasswordBox"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource CardHint}" FontStyle="Italic" Margin="0,0,0,14"
                                   Text="The same password is used for unlock(handle) and unlock(special bag)."/>

                        <TextBlock x:Name="VaultStatusText" TextWrapping="Wrap" Foreground="#B3261E" Margin="0,0,0,12"/>

                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Click="OnSave"/>
                    </StackPanel>
                </Border>

                <!-- ===================== Developer tools (hidden until Developer mode) ===================== -->
                <Border x:Name="DevPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource IconBadge}" Background="{StaticResource BrushAmberSoft}">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;" Foreground="{StaticResource BrushAmber}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Developer tools"/>
                                    <Border Background="{StaticResource BrushAmberSoft}" CornerRadius="6"
                                            Padding="7,1" Margin="10,1,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DEV" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="Diagnostics for troubleshooting. Most people never need these."/>
                            </StackPanel>
                        </Grid>

                        <!-- Logging -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Logging (DebugView)"/>
                        <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,12"
                                   Text="Flags are written to HKLM\SOFTWARE\T2TouchId\Logging. In DebugView enable Capture Global Win32 and Capture Kernel. Administrator rights are required to save."/>
                        <CheckBox x:Name="LogPowerCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10"
                                  Checked="OnLogFlagChanged" Unchecked="OnLogFlagChanged">
                            <TextBlock Text="Power / sleep / resume / shutdown (recommended)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="LogBioCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10"
                                  Checked="OnLogFlagChanged" Unchecked="OnLogFlagChanged">
                            <TextBlock Text="T2TouchIdBio (UMDF, CAPTURE / Windows Hello)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="LogBridgeCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10"
                                  Checked="OnLogFlagChanged" Unchecked="OnLogFlagChanged">
                            <TextBlock Text="BridgeXPC: connect / disconnect" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="LogTransportCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10"
                                  Checked="OnLogFlagChanged" Unchecked="OnLogFlagChanged">
                            <TextBlock Text="T2TouchIdTransport (kernel, D0Entry/D0Exit)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <CheckBox x:Name="LogNcmCheck" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,0"
                                  Checked="OnLogFlagChanged" Unchecked="OnLogFlagChanged">
                            <TextBlock Text="T2NCM (kernel, MiniportPause/Restart)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="LogStatusText" Style="{StaticResource StatusLine}" Margin="52,10,0,0"/>

                        <Border Height="1" Background="{StaticResource BrushLine}" Margin="0,18,0,18"/>

                        <!-- Transport override -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Transport override"/>
                        <CheckBox x:Name="Ipv4TunnelCheck" Style="{StaticResource ToggleSwitch}"
                                  Checked="OnTransportModeChanged" Unchecked="OnTransportModeChanged">
                            <StackPanel>
                                <TextBlock Text="Force IPv4 tunnel" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,2,0,0"
                                           Text="Until the next reboot. While on, automatic fallback is not used."/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Style="{StaticResource CardHint}" Margin="52,10,0,0"
                                   Text="Recommended T2Ncm interface setup: IPv4 169.254.84.1/16 and a neighbor entry 169.254.x.y → T2 MAC. After the first received frame the tunnel remembers the fe80 peer by itself."/>

                        <TextBlock Text="Auto-switch state" FontWeight="SemiBold" FontSize="12" Margin="52,14,0,2"/>
                        <TextBlock x:Name="WarmupStatusText" Style="{StaticResource StatusLine}" Margin="52,0,0,0"/>
                        <TextBlock x:Name="WarmupDetailText" Style="{StaticResource StatusLine}" FontSize="11.5" Margin="52,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================== Footer: Developer mode switch ===================== -->
                <Grid Margin="6,0,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Developer mode" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource CardHint}" Margin="0,1,0,0"
                                   Text="Show diagnostic and logging options."/>
                    </StackPanel>
                    <CheckBox x:Name="DevModeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center"
                              Checked="OnDevModeChanged" Unchecked="OnDevModeChanged"/>
                </Grid>
                <TextBlock Style="{StaticResource CardHint}" FontSize="11" Margin="6,6,6,12"
                           Text="Settings are stored under HKLM\SOFTWARE\T2TouchId and need administrator rights."/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
