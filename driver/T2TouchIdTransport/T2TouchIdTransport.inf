; T2TouchIdTransport.inf
; PoC-only. Not WHQL signed. Test-signing / Secure Boot test mode required
; on the target machine (see docs/milestone-2-hardware-results.md).

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = ; filled by build
CatalogFile = T2TouchIdTransport.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
; VERIFIED FROM SOURCE: Apple T2 SEP function, vendor 0x106B device 0x1802.
; Function/subsystem IDs intentionally left unrestricted (no &SUBSYS_ filter)
; until confirmed on the specific target board (docs/windows-transport-research.md).
%T2TouchIdTransport.DeviceDesc% = T2TouchIdTransport_Device, PCI\VEN_106B&DEV_1802

[T2TouchIdTransport_Device.NT]
CopyFiles = Drivers_Dir, T2SepBootstrap_CopyFiles

; Registers T2SepCoInstaller.dll as this device's co-installer. PnP calls
; its T2SepCoInstallerEntry export around DIF_INSTALLDEVICE; on the
; post-processing pass (after CopyFiles above and after
; T2TouchIdTransport_Service_Inst has started the kernel service) it
; installs/refreshes the T2SepBootstrap Win32 service that runs the
; register-ool -> load-keybag -> set-system-keybag -> unlock sequence from
; sep-vault.bin (see T2SepCoInstaller.cpp / T2SepBootstrapService.cpp).
; SepVaultGui.exe (staged by T2SepBootstrap_CopyFiles below, alongside the
; bootstrap exe) is NOT touched by the co-installer - it's a user-launched
; tool to populate sep-vault.bin, not a service.
[T2TouchIdTransport_Device.NT.CoInstallers]
CopyFiles = T2SepCoInstaller_CopyFiles
AddReg    = T2SepCoInstaller_AddReg

[T2SepCoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000,"T2SepCoInstaller.dll,T2SepCoInstallerEntry"

[T2SepCoInstaller_CopyFiles]
T2SepCoInstaller.dll

; T2SepBootstrap.exe / SepVaultGui.exe intentionally do NOT go through the
; driver-store DIRID (13) that Drivers_Dir uses for the .sys - they are
; plain user-mode binaries, not drivers, and T2SepCoInstaller.cpp's
; GetBootstrapExePath() hardcodes %SystemRoot%\System32\T2SepBootstrap\ to
; match this exact destination rather than re-deriving a driver-store path.
[T2SepBootstrap_CopyFiles]
T2SepBootstrap.exe
SepVaultGui.exe

; NOTE: no [T2TouchIdTransport_Device.NT.HW] / UpperFilters entry here.
; An earlier draft of this INF added
;   HKR,,"UpperFilters",0x00010000,"WdfKernelShim"
; but "WdfKernelShim" is not a real Windows component - it doesn't
; correspond to any documented service, coinstaller, or reflector (the
; closest real thing, WudfRd, is the UMDF reflector and is irrelevant to
; a KMDF driver like this one). PnP would look for a filter service by
; that name to load above this function driver and simply not find one,
; which is pure downside: it changes this PCI device's filter stack for
; no benefit. Do not re-add an UpperFilters/LowerFilters entry unless a
; specific, real filter driver actually needs to sit in this stack.

[T2TouchIdTransport_Device.NT.Services]
AddService = T2TouchIdTransport,0x000001fa,T2TouchIdTransport_Service_Inst

[T2TouchIdTransport_Service_Inst]
DisplayName   = %T2TouchIdTransport.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\T2TouchIdTransport.sys

[Drivers_Dir]
T2TouchIdTransport.sys

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
T2TouchIdTransport.sys = 1,,
T2SepCoInstaller.dll = 1,,
T2SepBootstrap.exe = 1,,
SepVaultGui.exe = 1,,

[DestinationDirs]
; DIRID 13 = "run from Driver Store", not a UMDF-specific path - this is
; the Microsoft-documented, Driver-Package-Isolation-compliant pattern
; for a KERNEL driver's service binary too (see "Run From Driver Store" /
; "Service binary" in the WDK docs), and it's already correctly paired
; with ServiceBinary = %13%\... above. Don't change this to 12 - that
; would only revert to the older, non-driver-store install style, not
; fix anything.
Drivers_Dir = 13
; Co-installer DLL also goes in the driver-store folder (DIRID 13), same as
; the .sys - PnP resolves an unqualified "file,entrypoint" CoInstallers32
; value (no path) by looking in the driver package's own store folder
; first, so this needs to be right next to T2TouchIdTransport.sys, not in
; System32.
T2SepCoInstaller_CopyFiles = 13
; DIRID 11 = %SystemRoot%\System32, subdirectory T2SepBootstrap - a plain
; filesystem location for the two ordinary user-mode binaries, deliberately
; NOT the driver store (see T2SepBootstrap_CopyFiles comment above).
T2SepBootstrap_CopyFiles = 11,T2SepBootstrap

[Strings]
ManufacturerName = "Osaul4ik"
DiskName = "T2TouchIdTransport Installation Disk"
T2TouchIdTransport.DeviceDesc = "Apple T2 SEP Mailbox"
T2TouchIdTransport.SvcDesc = "T2 Touch ID Transport"
